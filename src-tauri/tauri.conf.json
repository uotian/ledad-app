{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ledad",
  "version": "../package.json",
  "identifier": "jp.ledad.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [{ "label": "main", "title": "ledad", "width": 1440, "height": 960, "minWidth": 980, "minHeight": 700, "visible": false, "titleBarStyle": "Transparent", "theme": "Dark", "backgroundColor": "#4b3022", "backgroundThrottling": "disabled", "dragDropEnabled": false }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://generativelanguage.googleapis.com wss://generativelanguage.googleapis.com wss://api.openai.com; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:; font-src 'self'; object-src 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "resources": { "resources/": "resources/" },
    "macOS": { "minimumSystemVersion": "14.0", "entitlements": "Entitlements.plist", "infoPlist": "Info.plist" }
  }
}
